{
  "name": "@cuatoi/web-agent-core",
  "version": "0.1.0",
  "description": "Framework-agnostic core for the web-agent in-app browser agent: agent loop, tools, skills, datasources and provider transports.",
  "license": "Apache-2.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuatoi-dev/web-agent.git",
    "directory": "packages/web-agent-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "docs",
    "!**/*.test.*"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.json",
    "prepublishOnly": "node ../../scripts/assert-pnpm-publish.mjs && pnpm build",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "expr-eval-fork": "^3.0.3",
    "idb-keyval": "6.2.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.40",
    "eslint": "10.8.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "24.0.0",
    "typescript": "^5.5",
    "typescript-eslint": "8.67.0",
    "vitest": "^1.6"
  }
}
