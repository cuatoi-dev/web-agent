{
  "name": "@web-agent/cat-store",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "pnpm typecheck && webpack --mode production && webpack --config webpack.genui.config.js --mode production && pnpm build:server",
    "build:server": "node scripts/emit-cjs-marker.mjs && tsc -p tsconfig.server.json",
    "start:server": "node dist/node/server/index.js",
    "dev": "webpack serve --mode development",
    "test": "vitest run",
    "test:dom": "vitest run --config vitest.config.dom.ts",
    "test:watch": "vitest",
    "test:e2e": "E2E_ENV=mock playwright test",
    "test:e2e:gallery": "E2E_ENV=local playwright test",
    "test:e2e:mock": "E2E_ENV=mock playwright test",
    "test:e2e:demo": "E2E_ENV=demo playwright test",
    "capture:gallery": "E2E_ENV=local playwright test e2e/gallery-capture.mock.spec.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "acorn": "^8.17.0",
    "@cuatoi/web-agent-charting": "workspace:*",
    "@cuatoi/web-agent-core": "workspace:*",
    "@cuatoi/web-agent-dom": "workspace:*",
    "@cuatoi/web-agent-lit": "workspace:*",
    "@cuatoi/web-agent-mcp": "workspace:*",
    "@cuatoi/web-agent-openapi": "workspace:*",
    "@cuatoi/web-agent-vfs": "workspace:*",
    "@material/web": "^2",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@reduxjs/toolkit": "2.11.2",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "html-to-image": "1.11.13",
    "lit": "3.3.2",
    "marked": "18.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "20.19.40",
    "chart.js": "2.7.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "7.1.2",
    "eslint": "10.8.1",
    "html-webpack-plugin": "5.6.6",
    "jsdom": "24.0.0",
    "style-loader": "^4",
    "ts-loader": "9.5.4",
    "typescript": "^5.5",
    "typescript-eslint": "8.67.0",
    "vitest": "^1.6",
    "webpack": "5.106.2",
    "webpack-cli": "^5",
    "webpack-dev-server": "5.2.4"
  }
}
